# Free key from https://aistudio.google.com/apikey  (leave empty to use the rule-based parser)
GEMINI_API_KEY=
# Optional: override the model
GEMINI_MODEL=gemini-flash-latest
# Optional: seconds to wait for Gemini, and how much the model "thinks" (low = fast)
GEMINI_TIMEOUT=60
GEMINI_THINKING_LEVEL=low

# Free key from https://aistudio.google.com/apikey  (leave empty to use the rule-based parser)
GEMINI_API_KEY=
# Optional: model or comma-separated fallback chain (next one is tried if a model is overloaded)
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
# Optional: seconds to wait for each Gemini model, and how much the model "thinks" (low = fast)
GEMINI_TIMEOUT=20
GEMINI_THINKING_LEVEL=low
